# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Eval outputs (regenerated by src/eval.py). prompt_eval.json is the committed
# record of the zero-/few-shot citation results (CI gates on it); the rest is
# rewritten on every run.
results/*
!results/prompt_eval.json

# Claude Code local config
.claude/

# Local secrets (e.g. ANTHROPIC_API_KEY) — never commit
.env

# OS / editor
.DS_Store
.idea/
.vscode/
*.log

# Note: index/ and data/ ARE committed — the Space uses the prebuilt FAISS
# index and ships the sample PDF.
